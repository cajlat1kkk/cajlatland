<?xml version="1.0" encoding="UTF-8"?>
<actions>
  <action>
    <icon>utilities-terminal</icon>
    <name>Открыть в терминале</name>
    <submenu></submenu>
    <unique-id>1700000000001-1</unique-id>
    <command>kitty -1 --directory %f</command>
    <description>Открыть терминал Kitty в выбранной папке</description>
    <range>*</range>
    <patterns>*</patterns>
    <directories/>
  </action>
  <action>
    <icon>visual-studio-code</icon>
    <name>Открыть в VS Code</name>
    <submenu></submenu>
    <unique-id>1700000000002-2</unique-id>
    <command>code %F</command>
    <description>Открыть файл или папку в Visual Studio Code</description>
    <range>*</range>
    <patterns>*</patterns>
    <directories/>
    <text-files/>
  </action>
  <action>
    <icon>preferences-desktop-wallpaper</icon>
    <name>Установить как обои</name>
    <submenu></submenu>
    <unique-id>1700000000003-3</unique-id>
    <command>qs ipc call wallpaper set %f</command>
    <description>Применить изображение как обои и обновить палитру cajlatland</description>
    <range>*</range>
    <patterns>*</patterns>
    <image-files/>
  </action>
  <action>
    <icon>edit-copy</icon>
    <name>Копировать путь</name>
    <submenu></submenu>
    <unique-id>1700000000004-4</unique-id>
    <command>sh -c 'printf "%s" "$1" | wl-copy' _ %f</command>
    <description>Скопировать полный путь к файлу или папке</description>
    <range>*</range>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>
</actions>
